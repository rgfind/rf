{
  "config_version": 1,
  "release": {
    "branch": "main",
    "remote": "origin",
    "verification": {
      "ci": [
        { "id": "fmt", "argv": ["cargo", "fmt", "--check"], "timeout_seconds": 120 },
        { "id": "clippy", "argv": ["cargo", "clippy", "--all-targets", "--locked", "--", "-D", "warnings"], "timeout_seconds": 600 },
        { "id": "test", "argv": ["cargo", "test", "--locked"], "timeout_seconds": 600 }
      ],
      "release": [
        { "id": "publish-dry-run", "argv": ["cargo", "publish", "--dry-run", "--locked"], "timeout_seconds": 600 }
      ],
      "github_actions": {
        "repository": "rgfind/rf",
        "workflow_path": ".github/workflows/ci.yml"
      }
    }
  },
  "capture": {
    "build": [
      "cargo",
      "build",
      "--quiet",
      "--bin",
      "rf"
    ],
    "command": [
      "rf",
      "capabilities",
      "--json"
    ],
    "env": {
      "SOURCE_DATE_EPOCH": "0"
    }
  },
  "fixture": "tests/fixtures/contract/capabilities.rc.json",
  "normalize_meta": [
    "request_id",
    "ts_iso",
    "data_hash",
    "elapsed_ms"
  ],
  "surfaces": [
    "README.md",
    "CHANGELOG.md"
  ],
  "generated": [
    {
      "id": "readme-example",
      "surface": "README.md",
      "render": [
        "rf",
        "content",
        "timeout",
        ".",
        "--human"
      ],
      "env": {
        "SOURCE_DATE_EPOCH": "0",
        "NO_COLOR": "1"
      },
      "prompt": "$ rf content timeout .",
      "tree": {
        "git_init": true,
        "files": {
          "config.py": "timeout = 30\n",
          ".env.local": "timeout = 5      # hidden\n",
          "cache/build.py": "timeout = 999    # gitignored\n",
          ".gitignore": "cache/\n"
        }
      }
    },
    {
      "id": "why-example",
      "surface": "README.md",
      "render": [
        "rf",
        "why",
        "timeout",
        "cache/build.py",
        "--human"
      ],
      "env": {
        "SOURCE_DATE_EPOCH": "0",
        "NO_COLOR": "1"
      },
      "prompt": "$ rf why timeout cache/build.py --human",
      "tree": {
        "git_init": true,
        "files": {
          "cache/build.py": "timeout = 999    # gitignored\n",
          ".gitignore": "cache/\n"
        }
      }
    }
  ],
  "package_allowlist": "cargo-include",
  "claims": [
    {
      "id": "contract_version",
      "fact": "contract_version = 2 (a JSON string in both meta and data[0])",
      "fixture_path": "data.0.contract_version",
      "mode": "value",
      "expected": "2",
      "surface": "README.md",
      "section": "Status / The control surface",
      "tier": "P"
    },
    {
      "id": "tool_version",
      "fact": "tool_version = 0.0.7",
      "fixture_path": "tool_version",
      "mode": "value",
      "expected": "0.0.7",
      "surface": "README.md",
      "section": "Install",
      "tier": "P"
    },
    {
      "id": "envelope_keys",
      "fact": "envelope carries exactly seven top-level keys",
      "fixture_path": "",
      "mode": "keys",
      "expected": [
        "commands",
        "data",
        "errors",
        "meta",
        "ok",
        "tool_version",
        "warnings"
      ],
      "surface": "README.md",
      "section": "The control surface",
      "tier": "P"
    },
    {
      "id": "verb_set",
      "fact": "eight released verbs",
      "fixture_path": "data.0.verbs",
      "mode": "keys",
      "expected": [
        "capabilities",
        "conformance",
        "content",
        "doctor",
        "find",
        "robot-docs",
        "robot-docs guide",
        "why"
      ],
      "surface": "README.md",
      "section": "The pipeline case / control surface",
      "tier": "P"
    },
    {
      "id": "exit_code_set",
      "fact": "five exit codes 0,1,3,5,6",
      "fixture_path": "data.0.exit_codes",
      "mode": "keys",
      "expected": [
        "0",
        "1",
        "3",
        "5",
        "6"
      ],
      "surface": "README.md",
      "section": "The control surface",
      "tier": "P"
    },
    {
      "id": "exit5_retryable",
      "fact": "exit 5 (snapshot conflict) is the only retryable code",
      "fixture_path": "data.0.exit_codes.5.retryable",
      "mode": "value",
      "expected": true,
      "surface": "README.md",
      "section": "The control surface",
      "tier": "P"
    },
    {
      "id": "error_code_set",
      "fact": "twelve stable error codes",
      "fixture_path": "data.0.error_codes",
      "mode": "keys",
      "expected": [
        "BAD_PATTERN",
        "CONFLICT",
        "CONFORMANCE_FAIL",
        "HISTORY_ERROR",
        "INTERNAL",
        "INVALID_INPUT",
        "INVALID_SELECTION",
        "INVALID_TARGET",
        "MISSING_ARGUMENT",
        "UNKNOWN_COMMAND",
        "UNKNOWN_FLAG",
        "USAGE"
      ],
      "surface": "README.md",
      "section": "control surface (defers to capabilities)",
      "tier": "P"
    },
    {
      "id": "warning_code_set",
      "fact": "eighteen warning codes",
      "fixture_path": "data.0.warning_codes",
      "mode": "set",
      "expected": [
        "AST_STRUCTURAL",
        "BINARY_SKIPPED",
        "CASE_SENSITIVE",
        "ENCODING_MISS",
        "FD_HIDDEN",
        "FD_IGNORE",
        "FD_NAME",
        "GIT_ABSENT",
        "GIT_DELETED",
        "GIT_HISTORY_PARTIAL",
        "GIT_NOT_WORK_TREE",
        "GIT_SCRUB_WORD_UNAVAILABLE",
        "HIDDEN_SKIPPED",
        "IGNORE_MODE",
        "IGNORE_SOURCE_UNRESOLVED",
        "IGNORE_VCS",
        "RG_BINARY",
        "STRUCTURAL_UNAVAILABLE"
      ],
      "surface": "README.md",
      "section": "control surface (defers to capabilities)",
      "tier": "P"
    },
    {
      "id": "find_stage_enum",
      "fact": "find.stage has eight values",
      "fixture_path": "data.0.verbs.find.output_schema.data[].stage",
      "mode": "value",
      "expected": "enum[found,fd_name,fd_hidden,fd_ignore,fd_filter,rg_binary,git_deleted,ast_structural]",
      "surface": "README.md",
      "section": "The pipeline case: find",
      "tier": "P"
    },
    {
      "id": "content_surfaced_by_enum",
      "fact": "content.surfaced_by layers",
      "fixture_path": "data.0.verbs.content.output_schema.data[].surfaced_by",
      "mode": "value",
      "expected": "enum[default,vcs_ignore,hidden,binary,case,encoding_utf16]",
      "surface": "README.md",
      "section": "The pipeline case: find (content bullet)",
      "tier": "P"
    },
    {
      "id": "content_limit_name_guard",
      "fact": "content pagination flag is --limit at its fixture position",
      "fixture_path": "data.0.verbs.content.flags.2.name",
      "mode": "value",
      "expected": "--limit",
      "surface": "README.md",
      "section": "The control surface (pagination)",
      "tier": "P"
    },
    {
      "id": "content_limit_default",
      "fact": "content --limit default is 100",
      "fixture_path": "data.0.verbs.content.flags.2.default",
      "mode": "value",
      "expected": 100,
      "surface": "README.md",
      "section": "The control surface (pagination)",
      "tier": "P"
    },
    {
      "id": "content_limit_range",
      "fact": "content --limit range is 1..=1000",
      "fixture_path": "data.0.verbs.content.flags.2.range",
      "mode": "value",
      "expected": "1..=1000",
      "surface": "README.md",
      "section": "The control surface (pagination)",
      "tier": "P"
    }
  ]
}
