{
  "config_version": 1,
  "release": {
    "branch": "main",
    "remote": "origin",
    "verification": {
      "ci": [
        { "id": "fmt", "argv": ["cargo", "fmt", "--check"], "timeout_seconds": 120 },
        { "id": "clippy", "argv": ["cargo", "clippy", "--all-targets", "--locked", "--", "-D", "warnings"], "timeout_seconds": 600 },
        { "id": "test", "argv": ["cargo", "test", "--locked"], "timeout_seconds": 600 }
      ],
      "release": [
        { "id": "publish-dry-run", "argv": ["cargo", "publish", "--dry-run", "--locked"], "timeout_seconds": 600 }
      ],
      "github_actions": {
        "repository": "rgfind/rf",
        "workflow_path": ".github/workflows/ci.yml"
      }
    }
  },
  "capture": {
    "build": [
      "cargo",
      "build",
      "--quiet",
      "--bin",
      "rf"
    ],
    "command": [
      "rf",
      "capabilities",
      "--json"
    ],
    "env": {
      "SOURCE_DATE_EPOCH": "0"
    }
  },
  "fixture": "tests/fixtures/contract/capabilities.rc.json",
  "normalize_meta": [
    "request_id",
    "ts_iso",
    "data_hash",
    "elapsed_ms"
  ],
  "surfaces": [
    "README.md",
    "CHANGELOG.md"
  ],
  "generated": [
    {
      "id": "readme-example",
      "surface": "README.md",
      "render": [
        "rf",
        "content",
        "timeout",
        "."
      ],
      "env": {
        "SOURCE_DATE_EPOCH": "0",
        "NO_COLOR": "1"
      },
      "prompt": "$ rf content timeout .",
      "tree": {
        "git_init": true,
        "files": {
          "config.py": "timeout = 30\n",
          ".env.local": "timeout = 5      # hidden\n",
          "cache/build.py": "timeout = 999    # gitignored\n",
          ".gitignore": "cache/\n"
        }
      }
    },
    {
      "id": "why-example",
      "surface": "README.md",
      "render": [
        "rf",
        "why",
        "timeout",
        "cache/build.py"
      ],
      "env": {
        "SOURCE_DATE_EPOCH": "0",
        "NO_COLOR": "1"
      },
      "prompt": "$ rf why timeout cache/build.py",
      "tree": {
        "git_init": true,
        "files": {
          "cache/build.py": "timeout = 999    # gitignored\n",
          ".gitignore": "cache/\n"
        }
      }
    }
  ],
  "package_allowlist": "cargo-include",
  "claims": [
    {
      "id": "contract_version",
      "fact": "contract_version = 0.1 (a JSON string in meta and in data)",
      "fixture_path": "data.contract_version",
      "mode": "value",
      "expected": "0.1",
      "surface": "README.md",
      "section": "Status / The control surface",
      "tier": "P"
    },
    {
      "id": "tool_version",
      "fact": "tool_version = 0.1.0",
      "fixture_path": "tool_version",
      "mode": "value",
      "expected": "0.1.0",
      "surface": "README.md",
      "section": "Install",
      "tier": "P"
    },
    {
      "id": "envelope_keys",
      "fact": "envelope carries exactly seven top-level keys",
      "fixture_path": "",
      "mode": "keys",
      "expected": [
        "commands",
        "data",
        "errors",
        "meta",
        "ok",
        "tool_version",
        "warnings"
      ],
      "surface": "README.md",
      "section": "The control surface",
      "tier": "P"
    },
    {
      "id": "verb_set",
