    "IGNORE_MODE": {
      "appears_in": [
        "warnings"
      ],
      "details": "null",
      "exit": null,
      "fixture": "run doctor on a directory outside every Git repository",
      "precondition": "doctor reports the active ignore mode for the path",
      "sites": [
        "doctor"
      ],
      "summary": "doctor reports the active ignore mode for the path"
    },
    "IGNORE_SOURCE_UNRESOLVED": {
      "appears_in": [
        "warnings"
      ],
      "details": "details.files[]",
      "exit": null,
      "fixture": "run why on a file hidden by an ignore rule that rf cannot trace to one source line",
      "precondition": "the ignore rule that hides the file could not be identified",
      "sites": [
        "why"
      ],
      "summary": "the ignore rule that hides the file could not be identified"
    },
    "IGNORE_VCS": {
      "appears_in": [
        "warnings"
      ],
      "details": "details.files[]",
      "exit": null,
      "fixture": "put a match in a file that .gitignore names, then run content",
      "precondition": "a VCS-ignore rule hides a match from a default search",
      "sites": [
        "content",
        "why"
      ],
      "summary": "a VCS-ignore rule hides a match from a default search"
    },
    "INTERNAL": {
      "appears_in": [
        "errors"
      ],
      "details": "null",
      "exit": 7,
      "fixture": "test build only (cargo feature fault-injection): RF_FAULT=<diagnosis stage> rf --json content x",
      "precondition": "an injected fault",
      "sites": [
        "*"
      ],
      "summary": "defect in rf caught by the totality wrapper"
    },
    "INVALID_INPUT": {
      "appears_in": [
        "errors"
      ],
      "details": "null, or {bytes_hex} for undecodable argv",
      "example_invocation": "rf --json content --limit=0 x",
      "exit": 1,
      "sites": [
        "*"
      ],
      "summary": "a supplied value failed validation: type, range, enum, pattern, empty value, flag conflict, surplus positional, or malformed cursor"
