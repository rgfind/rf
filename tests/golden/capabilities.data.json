      "sites": [
        "find"
      ],
      "summary": "the name filter excludes a file whose content matches"
    },
    "GIT_ABSENT": {
      "appears_in": [
        "warnings"
      ],
      "details": "details.files[]",
      "exit": null,
      "fixture": "run find with a PATH that has no git",
      "precondition": "git is not available, so history was not searched",
      "sites": [
        "find"
      ],
      "summary": "git is not available, so history was not searched"
    },
    "GIT_DELETED": {
      "appears_in": [
        "warnings"
      ],
      "details": "details.files[]",
      "exit": null,
      "fixture": "commit a file that matches, delete it, commit, then run find",
      "precondition": "the match exists only in Git history",
      "sites": [
        "find"
      ],
      "summary": "the match exists only in Git history"
    },
    "GIT_HISTORY_PARTIAL": {
      "appears_in": [
        "warnings"
      ],
      "details": "null",
      "exit": null,
      "fixture": "run find in a repository whose history scan takes more than 2000 ms",
      "precondition": "the history scan budget ended before all revisions were read",
      "sites": [
        "find"
      ],
      "summary": "the history scan budget ended before all revisions were read"
    },
    "GIT_NOT_WORK_TREE": {
      "appears_in": [
        "warnings"
      ],
      "details": "details.files[]",
      "exit": null,
      "fixture": "run find in a directory outside every Git repository",
      "precondition": "the root is not a Git work tree, so history was not searched",
      "sites": [
        "find"
      ],
      "summary": "the root is not a Git work tree, so history was not searched"
    },
    "GIT_SCRUB_WORD_UNAVAILABLE": {
      "appears_in": [
        "warnings"
      ],
      "details": "details.files[]",
      "exit": null,
      "fixture": "run find --word in a repository with a history-only match",
