      "sites": [
        "find"
      ],
      "summary": "whole-word mode omits Git pickaxe evidence"
    },
    "HIDDEN_SKIPPED": {
      "appears_in": [
        "warnings"
      ],
      "details": "details.files[]",
      "exit": null,
      "fixture": "put a match in a dot-file, then run content",
      "precondition": "a hidden path hides a match from a default search",
