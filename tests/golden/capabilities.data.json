  "envelope_meta": {
    "data_hash": {
      "algorithm": "sha256",
      "canonicalization": "compact JSON, keys sorted, separators (',', ':')",
      "covers": "data",
      "format": "sha256:<64 hex>"
    },
    "request_id": {
      "format": "req_<16 hex>",
