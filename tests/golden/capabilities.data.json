{
  "contract_policy": {
    "policy_version": 2,
    "release_classification": "additive-pending-release-verification",
    "release_record": "release-records/0.0.8.md",
    "supported_contract_versions": [
      "0.1"
    ],
    "url": "https://github.com/rgfind/rf/blob/main/CONTRACT.md#contract-version-2"
  },
  "contract_version": "0.1",
  "diagnosis_order": [
    "bootstrap_mode",
    "global_flag",
    "command_path",
    "command_flag",
    "value_validation",
    "required_argument",
    "semantic_resolution",
    "execution"
  ],
  "engine": "in-process (ignore + grep crates); no subprocess",
  "env_vars": {
    "NO_COLOR": {
      "description": "suppress terminal decoration; rf output has none, so this has no effect",
      "industry_standard": true
    },
    "SOURCE_DATE_EPOCH": {
      "description": "fixed clock for reproducible output: sets meta.ts_iso and makes meta.elapsed_ms 0",
      "industry_standard": true
    }
  },
  "envelope_meta": {
    "data_hash": {
      "algorithm": "sha256",
      "canonicalization": "compact JSON, keys sorted, separators (',', ':')",
      "covers": "data",
      "format": "sha256:<64 hex>"
    },
    "request_id": {
      "format": "req_<16 hex>",
      "unique_per_invocation": true
    },
    "ts_iso": {
      "format": "RFC 3339 UTC with Z",
      "precision": "seconds"
    }
  },
  "error_codes": {
    "AST_STRUCTURAL": {
      "appears_in": [
        "warnings"
      ],
      "details": "details.files[]",
      "exit": null,
      "fixture": "run find --structural with a pattern that has no fixed literal form",
      "precondition": "the match comes only from the structural stage",
      "sites": [
        "find"
      ],
      "summary": "the match comes only from the structural stage"
    },
    "BAD_PATTERN": {
      "appears_in": [
        "errors"
      ],
      "details": "null",
      "example_invocation": "rf --json content '('",
      "exit": 1,
      "sites": [
        "content",
        "find",
        "why"
      ],
      "summary": "the search pattern failed to compile"
    },
    "BINARY_SKIPPED": {
      "appears_in": [
        "warnings"
      ],
      "details": "details.files[]",
      "exit": null,
      "fixture": "put a match after a NUL byte in a file, then run content",
      "precondition": "binary detection hides a match from a default search",
      "sites": [
        "content",
        "why"
      ],
      "summary": "binary detection hides a match from a default search"
    },
    "CASE_SENSITIVE": {
      "appears_in": [
        "warnings"
      ],
      "details": "details.files[]",
      "exit": null,
      "fixture": "search a lower-case pattern where the file holds the upper-case text",
      "precondition": "a search without case finds a match that the default search does not",
      "sites": [
        "content",
        "why"
      ],
      "summary": "a search without case finds a match that the default search does not"
    },
    "CONFLICT": {
      "appears_in": [
        "errors"
      ],
      "details": "null",
      "exit": 5,
      "fixture": "read meta.pagination.cursor from a --limit 1 page, add a file that matches, then send the cursor",
      "precondition": "a cursor from an earlier page, and a result set that changed after that page",
      "sites": [
        "content",
        "find"
      ],
      "summary": "a cursor snapshot no longer matches the current result set"
    },
    "CONFORMANCE_FAIL": {
      "appears_in": [
        "errors"
      ],
      "details": "null",
      "exit": 1,
      "fixture": "none in a correct build; the self-check of a defective build gives it",
      "precondition": "a build with a contract defect",
      "sites": [
        "conformance"
      ],
      "summary": "one or more conformance cases have verdict fail"
    },
    "ENCODING_MISS": {
      "appears_in": [
        "warnings"
      ],
      "details": "details.files[]",
      "exit": null,
      "fixture": "put a match in a UTF-16 file with a byte-order mark, then run content",
      "precondition": "UTF-16 decoding finds a match that the default search does not",
      "sites": [
        "content",
        "why"
      ],
      "summary": "UTF-16 decoding finds a match that the default search does not"
    },
    "EXTERNAL_TOOL_MISSING": {
      "appears_in": [
        "warnings"
      ],
      "details": "null",
      "exit": null,
      "fixture": "run doctor with a PATH that has no git or no ast-grep",
      "precondition": "an optional external tool cannot run",
      "sites": [
        "doctor",
        "find"
      ],
      "summary": "an optional external tool cannot run"
    },
    "FD_HIDDEN": {
      "appears_in": [
        "warnings"
      ],
      "details": "details.files[]",
      "exit": null,
      "fixture": "run find where the match is in a dot-file with the named extension",
      "precondition": "a hidden path excludes a file whose content matches",
      "sites": [
        "find"
      ],
      "summary": "a hidden path excludes a file whose content matches"
    },
    "FD_IGNORE": {
      "appears_in": [
        "warnings"
      ],
      "details": "details.files[]",
      "exit": null,
      "fixture": "run find where the match is in a file that .gitignore names",
