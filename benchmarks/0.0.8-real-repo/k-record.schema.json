{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "rf 0.0.8 real-repository K-record",
  "description": "Reference shape. validate.py is the authoritative stdlib-only validator.",
  "type": "object",
  "required": [
    "schema_version",
    "benchmark_id",
    "rf_release",
    "corpus",
    "ground_truth",
    "reset_rule",
    "arms",
    "model",
    "prompts",
    "tasks",
    "run_ids",
    "scores",
    "perf_rule",
    "measurements",
    "selected_A",
    "selected_limits",
    "artifact_checksums",
    "scope"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "benchmark_id": {"type": "string", "minLength": 1},
    "rf_release": {"type": "object", "required": ["version", "binary_sha256", "crate_sha256", "source_revision"]},
    "corpus": {"type": "object", "required": ["repo", "revision", "disk_states"]},
    "ground_truth": {"type": "object", "required": ["tool", "version", "command_template", "tasks"]},
    "reset_rule": {"type": "string", "minLength": 1},
    "arms": {"type": "array", "minItems": 2},
    "model": {"type": "object", "required": ["name", "effort", "harness_version"]},
    "prompts": {"type": "array", "minItems": 1},
    "tasks": {"type": "array", "minItems": 1},
    "run_ids": {"type": "array", "minItems": 1},
    "scores": {"type": "array", "minItems": 1},
    "perf_rule": {"type": "object", "required": ["corpus", "commands", "warmups", "runs", "statistic", "host", "max_regression_pct"]},
    "measurements": {"type": "array", "minItems": 1},
    "selected_A": {"type": "object", "required": ["evidence_schema", "max_matches_default", "per_match_text_cap", "per_response_cap", "decision_rule"]},
    "selected_limits": {"type": "object", "required": ["input", "external_tools", "structural_search"]},
    "artifact_checksums": {"type": "object"},
    "scope": {"type": "object", "required": ["evidence_for", "not_evidence_for"]}
  }
}
